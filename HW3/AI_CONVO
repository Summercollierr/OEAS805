import matplotlib.pyplot as plt
import numpy as np
from sklearn.metrics import r2_score

# Sample data
x = np.array([1, 2, 3, 4, 5])
y = np.array([1.2, 1.9, 3.2, 3.8, 5.1])

# Calculate linear regression line and R-squared score
slope, intercept = np.polyfit(x, y, 1)
y_pred = slope * x + intercept
r2 = r2_score(y, y_pred)

# Create scatter plot
plt.scatter(x, y, color='blue', label='Data Points')
plt.plot(x, y_pred, color='red', label='Fit Line')

# Add R-squared value at the top (Title)
plt.title(f"Linear Regression ($R^2 = {r2:.3f}$)", fontsize=14)

plt.xlabel("X Axis")
plt.ylabel("Y Axis")
plt.legend()
plt.show()
